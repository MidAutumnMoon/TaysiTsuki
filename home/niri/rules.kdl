// Example: enable rounded corners for all windows.
// (This example rule is commented out with a "/-" in front.)
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
    open-maximized-to-edges false
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// Open window maximized
window-rule {
    match app-id=r#"firefox$"#
    match app-id="firefox-developer-edition"
    match app-id="^(org.kde.dolphin)$"
    match app-id="^(org.telegram.desktop)$"
    match app-id="^(mpv)$"
    match app-id="^(vesktop)$"
    match app-id="^(feishin)$"
    match app-id="swayimg"
    match app-id="dev.zed.Zed"
    match app-id="CherryStudio"
    match app-id="YACReader"

    exclude is-floating=true

    open-maximized true
    open-focused true
}

window-rule {
    match app-id=r#"^org\.telegram\.desktop$"# title="^Media viewer$"
    match app-id=r#"^firefox$"# title="^Picture-in-Picture$"
    match app-id="org.gnome.Nautilus"
    match app-id="^(org.gnome.polkit-gnome-authentication-agent-1)$"
    match app-id="^(qt6ct)$"
    match app-id="^(nwg-look)$"
    match app-id="^(blueman-manager)$"
    match app-id="^(nm-applet)$"
    match app-id="^(nm-connection-editor)$"

    open-floating true
    open-fullscreen false
    open-maximized false
    // default-column-width { proportion 0.5; }
    background-effect {
        xray false
    }
}

// Make file chooser larger
window-rule {
    match app-id="(xdg-desktop-portal)(.*)"
    match app-id="filepicker"
    match app-id="org.freedesktop.impl.portal.desktop.kde"
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.8; }
    open-floating true
    open-fullscreen false
}

layer-rule {
    match namespace="^noctalia-(background|launcher-overlay|dock)-.*$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^launcher$"
    background-effect {
        blur true
        // xray false
    }
}
