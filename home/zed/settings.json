// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "language_models": {
        "openai_compatible": {
            "NanoGPT": {
                "api_url": "https://nano-gpt.com/api/v1",
                "available_models": [
                    {
                        "name": "minimax/minimax-m2.1",
                        "max_tokens": 120000,
                        "max_output_tokens": 90000,
                        "max_completion_tokens": 90000,
                        "capabilities": {
                            "tools": true,
                            "images": false,
                            "parallel_tool_calls": true,
                            "prompt_cache_key": true,
                        },
                    },
                    {
                        "name": "zai-org/glm-4.7:thinking",
                        "max_tokens": 120000,
                        "max_output_tokens": 60000,
                        "max_completion_tokens": 60000,
                        "capabilities": {
                            "tools": true,
                            "images": false,
                            "parallel_tool_calls": true,
                            "prompt_cache_key": true,
                        },
                    },
                ],
            },
        },
    },
    "colorize_brackets": true,
    "agent": {
        "favorite_models": [
            {
                "provider": "NanoGPT",
                "model": "minimax/minimax-m2.1",
            },
        ],
        "inline_assistant_model": {
            "provider": "openrouter",
            "model": "minimax/minimax-m2.1",
        },
        "default_model": {
            "provider": "NanoGPT",
            "model": "minimax/minimax-m2.1",
        },
        "thread_summary_model": {
            "provider": "openrouter",
            "model": "openai/gpt-oss-120b",
        },
        "commit_message_model": {
            "provider": "openrouter",
            "model": "openai/gpt-oss-120b",
        },
        "model_parameters": [{ "temperature": 0.8 }],
        "use_modifier_to_send": true,
    },
    "vim_mode": true,
    "vim": {
        "use_system_clipboard": "on_yank",
        "use_smartcase_find": true,
    },
    "vertical_scroll_margin": 10,
    "pane_split_direction_vertical": "right",
    "ui_font_size": 18,
    "ui_font_weight": 400,
    "buffer_font_size": 15.6,
    "buffer_font_family": "Monaspace Argon",
    "buffer_font_weight": 400,
    "theme": {
        "mode": "dark",
        "light": "Catppuccin Latte - No Italics",
        "dark": "Catppuccin Frappé - No Italics",
    },
    "autosave": {
        "after_delay": { "milliseconds": 800 },
    },
    "auto_update": false,
    "indent_guides": {
        "enabled": true,
        "coloring": "indent_aware",
    },
    "tabs": {
        "git_status": true,
        "file_icons": true,
    },
    "file_finder": {
        "modal_max_width": "medium",
    },
    "soft_wrap": "bounded",
    "git": {
        "inline_blame": { "enabled": false },
    },
    "git_panel": {
        "dock": "right",
    },
    "load_direnv": "direct",
    "show_completions_on_input": false,
    "relative_line_numbers": "enabled",
    "completions": {
        "words": "fallback",
    },
    "languages": {
        "Nix": {
            "language_servers": ["nixd", "!nil"],
            "tab_size": 4,
        },
        "JSONC": { "tab_size": 4 },
        "JSON": { "tab_size": 4 },
        "JavaScript": {
            "language_servers": [
                "deno",
                "!typescript-language-server",
                "!vtsls",
                "!eslint",
            ],
            "formatter": "language_server",
            "tab_size": 4,
        },
        "TypeScript": {
            "language_servers": [
                "deno",
                "!typescript-language-server",
                "!vtsls",
                "!eslint",
            ],
            "formatter": "language_server",
            "tab_size": 4,
        },
        "TSX": {
            "language_servers": [
                "deno",
                "!typescript-language-server",
                "!vtsls",
                "!eslint",
            ],
            "formatter": "language_server",
            "tab_size": 4,
        },
    },
    "inlay_hints": {
        // toggle inlay hint with ctrl-:
        "enabled": false,
        "toggle_on_modifiers_press": {
            // hold alt-shift to have a peek at inlay hints
            "shift": true,
            "alt": true,
        },
    },
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "check": { "command": "clippy" },
                "imports": {
                    "granularity": { "group": "item", "enforce": true },
                },
            },
        },
        "nixd": {
            "initialization_options": {
                "nixpkgs": { "expr": "null" },
                "options": {
                    "nixos": { "expr": "null" },
                    "home_manager": { "expr": "null" },
                },
            },
        },
        "harper-ls": {
            "settings": {
                "harper-ls": {
                    "linters": {
                        "ToDoHyphen": false,
                        "Dashes": false,
                        "ExpandMemoryShorthands": false,
                    },
                },
            },
        },
        "deno": {
            "settings": {
                "deno": { "enable": true },
            },
        },
        "json-language-server": {
            "settings": {
                "json": {
                    "schemas": [
                        {
                            "fileMatch": ["deno.json", "deno.jsonc"],
                            "url": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
                        },
                    ],
                },
            },
        },
    },
    "diagnostics": {
        "inline": { "enabled": true },
    },
    "edit_predictions": {
        "mode": "subtle",
    },
    "file_types": {
        "Shell Script": [".envrc"],
    },
    "minimap": {
        "show": "auto",
        "current_line_highlight": "line",
    },
}
