            "default": "allow",
            "tools": {
                "create_directory": {
                    "default": "allow",
                },
                "mcp:mcp-server-exa-search:web_search_exa": {
                    "default": "allow",
                },
                "mcp:mcp-server-context7:query-docs": {
                    "default": "allow",
                },
                "mcp:mcp-server-context7:resolve-library-id": {
                    "default": "allow",
                },
                "terminal": {
                    "always_allow": [
                        {
                            "pattern": "^grep\\b",
                        },
                        {
                            "pattern": "^cargo\\s+clippy(\\s|$)",
                        },
                        {
                            "pattern": "^cargo\\s+test(\\s|$)",
                        },
                        {
                            "pattern": "^sort\\b",
                        },
                        {
                            "pattern": "^deno\\s+task(\\s|$)",
                        },
                    ],
                },
            },
        },
        "favorite_models": [],
        "inline_assistant_model": {
            "provider": "Volcengine",
            "model": "kimi-k2.7-code",
        },
        "default_model": {
            "effort": "xhigh",
            "provider": "Volcengine",
            "model": "glm-5.2",
