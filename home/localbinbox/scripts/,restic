#!/usr/bin/env -S nu

use std/assert

def --wrapped main [...args] {
    let here = ($env.CURRENT_FILE | path dirname)
    let sops_file = ($here | path join "passwd--restic.sops.yml")

    # Decrypt password using sops
    let password: string = (
        ^sops decrypt $sops_file
        | from yaml
        | get passwd
        | str trim )

    if ($password | is-empty) {
        print "Failed to decrypt password"
        exit 1
    }
    $env.RESTIC_PASSWORD = $password

    $env.RESTIC_REPOSITORY = "rclone:Box:Pool/Restic/TopSecret"
    $env.RESTIC_PACK_SIZE = "128"

    let backup_dirs = [
        ($env.HOME | path join "Documents/TopSecret")
    ]

    # let config_hash_before = if ($config | path exists) {
    #     (open $config | hash sha256)
    # } else { "" }

    let command = if ($args | is-empty) {
        [
            "backup",
            ($backup_dirs | to text | str trim)
        ]
    } else {
        $args
    }

    ^restic ...$command

    # let config_hash_after = if ($config | path exists) {
    #     (open $config | hash sha256)
    # } else { "" }

    # if ($config_hash_before != $config_hash_after) {
    #     print "repo config changed"
    #     let current_time = (date now | format date "%Y-%m-%d--%H-%M")
    #     let new_config_path = $"($config)-($current_time)"
    #     cp $config $new_config_path
    # }
}
