#!/usr/bin/env ruby

# frozen_string_literal: true

require "reinbow"
require "pathname"
require "shellwords"

using Reinbow

BACKUP_DIR = Pathname.pwd.join ".backup"

# TODO: coordinate rename original to .backup
abort "Leaftover backup folder found".red \
    if not Pathname.pwd.glob( "./**/original" ).empty?

abort %("#{BACKUP_DIR}" exists).red \
    if BACKUP_DIR.exist?

BACKUP_DIR.mkdir

warn %(BACKUP_DIR is "#{BACKUP_DIR}").yellow

warn "Glob pwd for directories to be archived".yellow
warn "However files are ignored".yellow

Pathname.pwd
    .glob( "*" )
    .select( &:directory? )
    .each \
do |input|

    puts %(Archiving "#{input.basename}").blue

    archive_name = Pathname.new "#{input}.7z"

    # lzma2 compression
    # ultra
    # solid block 16GB
    # dictionary 3840MB
    # large pages
    system <<~SH or abort "Failed to run 7z".red
        command 7zz a \
            -slp -ssp \
            -sas -t7z \
            -m0=lzma2 \
            -mx9 -myx9 \
            -ms=16G \
            -md=3840M \
            -- \
            #{archive_name.to_s.shellescape} \
            #{input.to_s.shellescape}
    SH

    warn "Move to backup".blue

    BACKUP_DIR.join( input.basename )
        .then { input.rename it }

    warn "Generate parchive".blue

    system <<~SH or abort "Failed to par".red
        ,par #{archive_name.to_s.shellescape}
    SH

end
