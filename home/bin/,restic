#!/usr/bin/env -S ruby

# frozen_string_literal: true

require "shellwords"

ENV["RESTIC_REPOSITORY"] = "/mnt/pool/Restic/Bucket"
ENV["RESTIC_PASSWORD"] = "f83d58e0-b7d0-4285-b460-defa583f9e62"
ENV["RESTIC_PACK_SIZE"] = "128"

BACKUP_DIRS = [
    "$HOME/Hotaru/Pictures/TopSecret/",
].freeze

command = if ARGV.empty?
              "backup #{BACKUP_DIRS.join ' '}"
          else
              ARGV.shelljoin
          end

system <<~CMD or abort "failed to run restic"
    restic #{command}
CMD
