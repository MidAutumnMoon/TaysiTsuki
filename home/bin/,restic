#!/usr/bin/env -S ruby

# frozen_string_literal: true

require "shellwords"
require "pathname"
require "English"
require "fileutils"
require "digest/sha2"
require "time"

HERE = Pathname.new(__dir__)
SOPS_FILE = HERE.join("passwd--restic.sops.yml")

PASSWORD = `sops decrypt #{SOPS_FILE} --extract '["passwd"]'`.strip.freeze
abort "Failed to decrypt password" if not $CHILD_STATUS.success?
abort "Password appears to be empty?" if PASSWORD.empty?

REPOSITORY = Pathname.new("/mnt/pool/Restic/TopSecret").tap(&:mkpath)
CONFIG = REPOSITORY.join("config")

ENV["RESTIC_PASSWORD"] = PASSWORD
ENV["RESTIC_REPOSITORY"] = REPOSITORY.to_s
ENV["RESTIC_PACK_SIZE"] = "128"

BACKUP_DIRS = [
    "$HOME/Documents/TopSecret",
].freeze

command =
    if ARGV.empty?
        # TODO: shellescape?
        "backup #{BACKUP_DIRS.join(' ')}"
    else
        ARGV.shelljoin
    end

CONFIG_HASH_BEFORE = Digest::SHA256.hexdigest(CONFIG.read)

system <<~SH or abort "failed to run restic"
    restic #{command}
SH

CONFIG_HASH_AFTER = Digest::SHA256.hexdigest(CONFIG.read)

if CONFIG_HASH_BEFORE != CONFIG_HASH_AFTER
    puts "repo config changed"
    current_time = Time.now.strftime("%Y-%m-%d--%H-%M")
    new_config_path = "#{CONFIG}-#{current_time}"
    FileUtils.cp(CONFIG, new_config_path)
end