#!/usr/bin/env ruby

# frozen_string_literal: true

require "pathname"
require "English"
require "shellwords"
require "reinbow"

using Reinbow

if ARGV.empty?
    warn "No argument given, glob current directory".yellow
    INPUTS = Pathname.pwd.glob( "*" )
else
    INPUTS = ARGV
        .map { Pathname.new it }
        .map( &:realpath )
end

def par2( dst )
    files = []

    if dst.file?
        warn "It is file".yellow
        files.push dst
    elsif dst.directory?
        warn "It is directory".yellow
        dst.glob( "*" )
            .select( &:file? )
            .then { files.concat it }
    else
        abort "The argument is neither file nor directory".red
    end

    puts "Generate parchive".yellow

    files.each do |f|
        warn %(par2-ing "#{f}").blue
        Dir.chdir( f.dirname ) do
            basename = f.basename
            # -n1 : one redundency file
            # -r5 : 5% of redundency
            system <<~SH or abort "Failed to run par2".red
                par2 create -n1 -r5 -q #{basename.to_s.shellescape}
            SH

            # only the volume data is enough
            par2main = Pathname.new "#{basename}.par2"
            par2volume = Pathname.glob( "#{basename.to_s.shellescape}.vol*.par2" )
                .tap { abort "Par2 vol file not found" if it.empty? }
                .tap { abort "Found multiple par2 vol files" if it.size > 1 }
                .then( &:pop )

            par2main.delete
            par2volume.rename( par2main.to_s )
        end
    end

    puts "Generate checksum".yellow

    if dst.file?
        Dir.chdir( dst.dirname )
        checksum_name = "#{dst.basename}.sha256sum"
    elsif dst.directory?
        Dir.chdir( dst )
        checksum_name = "__directory.sha256sum"
    end

    files = files
        .map { Pathname.new "#{it}.par2" }
        .then { files.concat it }
        .map( &:basename ) # N.B. chdir above
        .sort

    system <<~SH or abort "Failed to run sha256sum".red
        sha256sum --binary #{files.shelljoin} | tee "#{checksum_name}"
    SH
end

INPUTS.each do
    par2 it
end
