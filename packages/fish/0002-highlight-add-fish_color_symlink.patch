+
+        // Cursor outside every argument, so all tokens take the deterministic wstat arm.
+        let text = L!("echo linkdir dangling realdir").to_owned();
+        let mut colors = vec![];
+        highlight_shell(
+            &text,
+            &mut colors,
+            &mut OperationContext::background(vars, EXPANSION_LIMIT_BACKGROUND),
+            true, /* io_ok */
+            None, /*cursor=*/
+        );
+
+        // Argument ranges within "echo linkdir dangling realdir".
+        fn spec_is(
+            colors: &[HighlightSpec],
+            range: std::ops::Range<usize>,
+            valid_path: bool,
+            symlink: bool,
+        ) {
+            for i in range {
+                assert_eq!(
+                    colors[i],
+                    HighlightSpec {
+                        valid_path,
+                        symlink,
+                        ..HighlightSpec::with_fg(HighlightRole::Param)
+                    },
+                    "unexpected HighlightSpec at position {i}"
+                );
+            }
+        }
+        spec_is(&colors, 5..12, true, true); // linkdir: valid path and a symlink.
+        spec_is(&colors, 13..21, false, true); // dangling: not a path, still a symlink.
+        spec_is(&colors, 22..28, true, false); // realdir: valid path, not a symlink.
+
+        // Resolve the spec the way fish_color_command is checked in test_resolve_role.
+        let symlink_face =
+            parse_text_face_for_highlight(&vars.get(L!("fish_color_symlink")).unwrap()).unwrap();
+        let valid_path_face =
+            parse_text_face_for_highlight(&vars.get(L!("fish_color_valid_path")).unwrap()).unwrap();
+        let mut resolver = HighlightColorResolver::new();
+        for i in [5, 13] {
+            assert_eq!(resolver.resolve_spec(&colors[i], vars), symlink_face);
+        }
+        // Control: "realdir" takes the active valid_path face.
+        assert_eq!(resolver.resolve_spec(&colors[22], vars), valid_path_face);
+
+        // Unset ⇒ the built-in default applies and must equal the words set above.
+        // Resolver results are cached with no invalidation, so rebuild the resolver
+        // after each var change.
+        vars.remove(L!("fish_color_symlink"), EnvSetMode::default());
+        let mut fresh_resolver = HighlightColorResolver::new();
+        for i in [5, 13] {
+            assert_eq!(fresh_resolver.resolve_spec(&colors[i], vars), symlink_face);
+        }
+
+        // Opt-out: set-but-empty parses to a no-op face ⇒ "linkdir" falls back to the
+        // valid_path face, "dangling" to plain param.
+        vars.set(
+            L!("fish_color_symlink"),
+            EnvSetMode::new_at_early_startup(EnvMode::LOCAL),
+            vec![L!("").to_owned()],
+        );
+        let mut opt_out_resolver = HighlightColorResolver::new();
+        assert_eq!(
+            opt_out_resolver.resolve_spec(&colors[5], vars),
+            valid_path_face
+        );
+        let plain_param = HighlightSpec::with_fg(HighlightRole::Param);
+        assert_eq!(
+            opt_out_resolver.resolve_spec(&colors[13], vars),
+            opt_out_resolver.resolve_spec(&plain_param, vars)
+        );
+
+        // With the valid-path var removed too, the opt-out state is fully stock.
+        vars.remove(L!("fish_color_valid_path"), EnvSetMode::default());
+        let mut stock_resolver = HighlightColorResolver::new();
+        for i in [5, 13, 22] {
+            assert_eq!(
+                stock_resolver.resolve_spec(&colors[i], vars),
+                stock_resolver.resolve_spec(&plain_param, vars)
+            );
+        }
+    }
+
     /// Tests that trailing spaces after a command don't inherit the underline formatting of the
     /// command.
     #[test]
