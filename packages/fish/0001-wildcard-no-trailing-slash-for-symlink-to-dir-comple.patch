+                            // `/` (see wildcard_test_flags_then_complete), so insert
+                            // the separator here or the push would yield `resultsub/`;
+                            // real-dir completions already end in `/`.
+                            // REBASE: anchor is the `c.completion.push_utfstr(&unique_hierarchy)`
+                            // loop in try_add_completion_result.
+                            if !c.completion.ends_with('/') {
+                                c.completion.push_utfstr(L!("/"));
+                            }
